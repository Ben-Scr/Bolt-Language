# These options build the compiler, embedding library and runtime themselves.
option(BOLT_TOOLCHAIN_IPO "Enable interprocedural optimization in Release toolchain builds" OFF)
set(BOLT_TOOLCHAIN_PGO OFF CACHE STRING "Release toolchain profiling mode (OFF, GENERATE, USE)")
set_property(CACHE BOLT_TOOLCHAIN_PGO PROPERTY STRINGS OFF GENERATE USE)
set(BOLT_TOOLCHAIN_PROFILE_DIR "${CMAKE_BINARY_DIR}/bolt-profiles" CACHE PATH "Shared profile directory for the generation and use builds")

if(NOT BOLT_TOOLCHAIN_PGO MATCHES "^(OFF|GENERATE|USE)$")
    message(FATAL_ERROR "BOLT_TOOLCHAIN_PGO must be OFF, GENERATE, or USE")
endif()

if(BOLT_TOOLCHAIN_IPO)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT bolt_ipo_supported OUTPUT bolt_ipo_reason LANGUAGES CXX)
    if(NOT bolt_ipo_supported)
        message(FATAL_ERROR "Toolchain IPO is unavailable: ${bolt_ipo_reason}")
    endif()
    # Every internal consumer of a native LTO archive needs an IPO-capable linker.
    get_property(bolt_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS bolt_targets)
        get_target_property(bolt_links "${target}" LINK_LIBRARIES)
        if(target MATCHES "^(BoltObjects|BoltCore|BoltRuntime)$" OR "BoltCore" IN_LIST bolt_links)
            set_property(TARGET "${target}" PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
        endif()
    endforeach()
endif()

if(BOLT_TOOLCHAIN_PGO STREQUAL "OFF")
    return()
endif()

if(NOT IS_ABSOLUTE "${BOLT_TOOLCHAIN_PROFILE_DIR}")
    message(FATAL_ERROR "BOLT_TOOLCHAIN_PROFILE_DIR must be an absolute path shared by both builds")
endif()

if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 10)
    # Object names are stable across separate build trees after stripping the prefix.
    set(bolt_profile_compile "-fprofile-prefix-path=${CMAKE_BINARY_DIR}")
    if(BOLT_TOOLCHAIN_PGO STREQUAL "GENERATE")
        file(MAKE_DIRECTORY "${BOLT_TOOLCHAIN_PROFILE_DIR}")
        set(bolt_profile_flag "-fprofile-generate=${BOLT_TOOLCHAIN_PROFILE_DIR}")
        list(APPEND bolt_profile_compile -fprofile-update=atomic)
    else()
        file(GLOB_RECURSE bolt_profile_data "${BOLT_TOOLCHAIN_PROFILE_DIR}/*.gcda")
        if(NOT bolt_profile_data)
            message(FATAL_ERROR "No GCC training data in ${BOLT_TOOLCHAIN_PROFILE_DIR}")
        endif()
        set(bolt_profile_flag "-fprofile-use=${BOLT_TOOLCHAIN_PROFILE_DIR}")
        list(APPEND bolt_profile_compile -Werror=missing-profile -Werror=coverage-mismatch)
    endif()
elseif(CMAKE_CXX_COMPILER_ID MATCHES "^(AppleClang|Clang)$" AND NOT MSVC)
    if(BOLT_TOOLCHAIN_PGO STREQUAL "GENERATE")
        file(MAKE_DIRECTORY "${BOLT_TOOLCHAIN_PROFILE_DIR}/raw")
        set(bolt_profile_flag "-fprofile-instr-generate=${BOLT_TOOLCHAIN_PROFILE_DIR}/raw/%m-%p.profraw")
    else()
        if(NOT EXISTS "${BOLT_TOOLCHAIN_PROFILE_DIR}/bolt.profdata")
            message(FATAL_ERROR "Merge the Clang training profiles into ${BOLT_TOOLCHAIN_PROFILE_DIR}/bolt.profdata")
        endif()
        set(bolt_profile_flag "-fprofile-instr-use=${BOLT_TOOLCHAIN_PROFILE_DIR}/bolt.profdata")
        list(APPEND bolt_profile_compile -Werror=profile-instr-out-of-date)
    endif()
else()
    message(FATAL_ERROR "Toolchain PGO requires GCC 10+ or Clang with the GNU-style driver")
endif()

foreach(target IN ITEMS BoltObjects Bolt BoltCompiler)
    foreach(flag IN LISTS bolt_profile_compile bolt_profile_flag)
        target_compile_options(${target} PRIVATE "$<$<CONFIG:Release>:${flag}>")
    endforeach()
endforeach()
target_link_options(BoltRuntime PRIVATE "$<$<CONFIG:Release>:${bolt_profile_flag}>")
# Static-archive consumers must link the same profiling runtime during training.
target_link_options(BoltCore INTERFACE "$<$<CONFIG:Release>:${bolt_profile_flag}>")
