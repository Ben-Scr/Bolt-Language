namespace Bolt.Runtime.NetApi;

// The order of ai_addr and ai_canonname differs between glibc/musl and Winsock/BSD.
struct AddressInfo {
public:
    int Flags, Family, SocketType, Protocol;
#ifdef Windows
    ulong Length;
#else
    uint Length;
#endif
#if Linux || Web
    byte* Address;
    byte* CanonicalName;
#else
    byte* CanonicalName;
    byte* Address;
#endif
    AddressInfo* Next;
}
#ifdef Windows
[Header("winsock2.h"), Native("WSAStartup")]
extern "C" int WSAStartup(ushort version, void* data);
[Header("winsock2.h"), Native("WSACleanup")]
