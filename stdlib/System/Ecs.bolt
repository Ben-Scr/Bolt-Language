    Registry();
    void Reserve(long capacity);
    Entity Create();
    [NativePack(1)] Entity Create<T...>();
    void Destroy(Entity entity);
    bool IsValid(Entity entity);
    long GetEntityCount();
    [NativeProperty("EntityCount")] const long EntityCount;
