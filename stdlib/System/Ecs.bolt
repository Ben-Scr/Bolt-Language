    Query Stable();
    [NativeProperty("Count")] const long Count;
    bool IsEmpty();
}
[Native("bolt::library::ecs::ComponentQuery")] public class ComponentQuery {
public:
    [NativePack(1)] ComponentQuery With<T...>();
    [NativePack(1)] ComponentQuery Without<T...>();
    ComponentQuery WithoutEntity();
    ComponentQuery Stable();
    [NativeProperty("Count")] const long Count;
    bool IsEmpty();
}
