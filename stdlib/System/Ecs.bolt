namespace Ecs;
[Native("bolt::library::ecs::Entity")] public struct Entity {
public:
    const uint Index;
    const uint Generation;
    string ToString();
}
[Native("bolt::library::ecs::ComponentSignal")] public class ComponentSignal<T> {
public:
    ulong Connect<H>(H handler);
    ulong ConnectRef<H>(H& handler);
    bool Disconnect(ulong token);
    void Clear();
    [NativeProperty("Count")] const int Count;
}
[Native("bolt::library::ecs::Components")] public class Components {
public:
    T& Get<T>();
    T* TryGet<T>();
    [NativePack(1)] bool Has<T...>();
    bool IsValid();
}
[Native("bolt::library::ecs::Row")] public class Row : Components {
public:
    [NativeProperty("Entity")] const Entity Entity;
}
[Native("bolt::library::ecs::Query")] public class Query {
public:
    [NativePack(1)] Query With<T...>();
    [NativePack(1)] Query Without<T...>();
