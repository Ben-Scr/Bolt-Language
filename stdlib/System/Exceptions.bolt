namespace System;

[Native("bolt::library::Exception")]
public class Exception
{
public:
    Exception(string message = "");
    [ReadOnly] virtual string ToString();
    [NativeProperty("Message")] const string Message;
    [NativeProperty("StackTrace")] const string StackTrace;
    [NativeProperty("SourceFile")] const string SourceFile;
    [NativeProperty("SourceLine")] const int SourceLine;
    [NativeProperty("SourceColumn")] const int SourceColumn;

}

[Native("bolt::library::SystemException")]
public class SystemException : Exception
{
public:
    SystemException(string message = "");

}

[Native("bolt::library::ArgumentException")]
public class ArgumentException : SystemException
{
public:
    ArgumentException(string message = "");

}

