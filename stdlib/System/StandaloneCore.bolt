    // Opcodes follow the table in Builder::call. ToArray has the same element
    // descriptor and one-dimensional header as a buffer, with an exact capacity.
    void BufferAction(byte* ctx,byte* site,byte* type,byte* slot,int operation,byte* output,byte* a,byte* b) {
        byte* h=Ptr(slot,0ul),element=Ptr(type,16ul);
        ulong count=Count(h),stride=Word(element,8ul);
        if(operation==6){
            if(slot!=a && RegionOf(ctx,slot)!=RegionOf(ctx,a)){
                byte* left=null,right=null;
                CopyInto(ctx,site,type,(byte*)&left,a,RegionOf(ctx,slot));
                if(*((int*)ctx)!=0)return;
                CopyInto(ctx,site,type,(byte*)&right,slot,RegionOf(ctx,a));
                if(*((int*)ctx)!=0){br_drop(type,(byte*)&left);return;}
                MovePrepared(ctx,type,slot,(byte*)&left);MovePrepared(ctx,type,a,(byte*)&right);return;
            }
            if(slot!=a){Mutated(ctx,slot);Mutated(ctx,a);Put(slot,0ul,Ptr(a,0ul));Put(a,0ul,h);}return;
        }
        if(operation==7){
            byte* copy=null;ArrayInto(ctx,site,type,(byte*)&copy,&count,1ul,RegionOf(ctx,output));
            if(copy==null)return;
            byte* data=Ptr(copy,0ul);
            if(count>0ul){
                byte* from=Ptr(h,0ul);
                for(ulong i=0ul;i<count;i++){
                    br_copy(ctx,site,element,&data[i*stride],&from[i*stride]);
                    if(*((int*)ctx)!=0){WordSet(copy,8ul,i);br_drop(type,(byte*)&copy);return;}
                }
            }
            Mutated(ctx,output);br_drop(type,output);Put(output,0ul,copy);return;
        }
        if(operation==1){InsertBuffer(ctx,site,type,slot,count,a,1ul);return;}
        long index=operation==5 ? 0l : (long)(*((int*)a));
        if(index<0l){Bounds(ctx,site);return;}
        ulong at=(ulong)index;
        if(operation==0){ReserveBuffer(ctx,site,type,slot,at,false);return;}
        if(at>count || (operation==3 && at==count)){Bounds(ctx,site);return;}
        if(operation==2){InsertBuffer(ctx,site,type,slot,at,b,1ul);return;}
        if(h==null)return;
        byte* data=Ptr(h,0ul);
