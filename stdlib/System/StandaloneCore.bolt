            payload=Allocate(Word(actual,8ul));
            if(payload==null){OutOfMemory(ctx,site);return;}
            br_copy(ctx,site,actual,payload,value);
            if(*((int*)ctx)!=0){br_drop(actual,payload);Free(payload);return;}
        }
        byte* origin=Ptr(value,16ul);if(origin==null)origin=site;
        Error(ctx,origin,actual,payload==null ? Ptr(value,8ul) : null);
        byte* e=Ptr(ctx,40ul);
        if(e==null){if(payload!=null){br_drop(actual,payload);Free(payload);}return;}
        Put(e,48ul,payload);
        byte* object=ErrorValue(e);Put(object,16ul,origin);
        if(payload==null)AssignText(ctx,site,&object[24ul],Ptr(value,24ul));
    }
    int br_exception_match(byte* ctx,byte* type) {
        if(type==null)return 1;
        byte* e=Ptr(ctx,40ul);if(e==null)return 0;
        byte* current=Ptr(e,8ul);
        while(current!=null){if(current==type)return 1;current=Ptr(current,24ul);}
        return 0;
    }
    byte* br_catch_begin(byte* ctx,byte* site) {
        byte* e=Ptr(ctx,40ul);if(e==null)return null;
        Put(e,0ul,Ptr(ctx,48ul));Put(ctx,48ul,e);Put(ctx,40ul,null);*((int*)ctx)=0;
        return ErrorValue(e);
    }
    void br_catch_end(byte* ctx) {byte* e=Ptr(ctx,48ul);if(e!=null){Put(ctx,48ul,Ptr(e,0ul));DisposeError(e);}}
    void br_rethrow(byte* ctx,byte* site) {
        byte* e=Ptr(ctx,48ul);
        if(e!=null)br_raise(ctx,site,Ptr(e,8ul),ErrorValue(e));
    }
    void br_error_suspend(byte* ctx,byte* dest) {Put(dest,0ul,Ptr(ctx,40ul));Put(ctx,40ul,null);*((int*)ctx)=0;}
    void br_error_restore(byte* ctx,byte* dest) {
        if(*((int*)ctx)!=0)DisposeError(Ptr(dest,0ul));
        else {Put(ctx,40ul,Ptr(dest,0ul));*((int*)ctx)=1;}
        Put(dest,0ul,null);
    }
    void CheckedFailure(byte* ctx,byte* site,byte* type,byte* message) {
        byte* h=null;br_string(ctx,site,(byte*)&h,message,CLength(message));
        Error(ctx,site,type,h);ReleaseText(h);
    }
    ulong SiteNumber(byte* site,ulong* offset) {
        ulong n=0ul;
        while(site[*offset]>=48 && site[*offset]<=57){n=n*10ul+(ulong)(site[*offset]-48);*offset+=1ul;}
        if(site[*offset]==58)*offset+=1ul;
        return n;
    }
    int SourceNumber(byte* object,bool column) {
        byte* site=Ptr(object,16ul);if(site==null)return 0;
        ulong at=0ul,line=SiteNumber(site,&at);
        return column ? (int)SiteNumber(site,&at) : (int)line;
    }
    void SourceFile(byte* ctx,byte* object,byte* dest) {
        byte* site=Ptr(object,16ul);ulong at=0ul;
        if(site==null){AssignText(ctx,null,dest,null);return;}
        SiteNumber(site,&at);SiteNumber(site,&at);SiteNumber(site,&at);
