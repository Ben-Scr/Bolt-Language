    void br_buffer_append(byte* ctx,byte* site,byte* type,byte* slot,byte* source,int offset,int length) {
        byte* h=Ptr(source,0ul);ulong count=Count(h);
        if(offset<0 || length<0 || (ulong)offset>count || (ulong)length>count-(ulong)offset){Bounds(ctx,site);return;}
        if(length==0)return;
