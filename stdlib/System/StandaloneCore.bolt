        for(ulong i=0ul;i<length;i++){
            CopyInto(ctx,site,element,&values[i*stride],&input[i*stride],RegionOf(ctx,slot));
            if(*((int*)ctx)!=0){WordSet(staged,8ul,i);br_drop(type,(byte*)&staged);return;}
        }
        byte* h=ReserveBuffer(ctx,site,type,slot,count+length,true);
        if(h==null){br_drop(type,(byte*)&staged);return;}
        byte* data=Ptr(h,0ul);
        for(ulong i=count;i>at;i--)Bytes(&data[(i-1ul+length)*stride],&data[(i-1ul)*stride],stride);
