    int Finish(byte* ctx,int status) {
        if(*((int*)ctx)==0)return status;
        byte* e=Ptr(ctx,40ul);
        if(e!=null) {
            byte* object=ErrorValue(e),site=Ptr(object,16ul),source=null;byte colon=58,space=32,lf=10;
            if(site!=null){
                ulong at=0ul;SiteNumber(site,&at);SiteNumber(site,&at);ulong position=at;
                SiteNumber(site,&at);ulong len=SiteNumber(site,&at);
                WriteError(&site[at],len);WriteError(&colon,1ul);WriteError(site,position);WriteError(&space,1ul);
                source=&site[at+len];
