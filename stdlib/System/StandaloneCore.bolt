        if(stride==2ul){*((int*)output)=FindIntegerWidth<ushort>(data,count,key);return;}
        if(stride==4ul){*((int*)output)=FindIntegerWidth<uint>(data,count,key);return;}
        if(stride==8ul){*((int*)output)=FindIntegerWidth<ulong>(data,count,key);return;}
        for(ulong i=0ul;i<count;i++){
            ulong n=0ul;while(n<stride && data[i*stride+n]==key[n])n++;
            if(n==stride){*((int*)output)=(int)i;return;}
        }
