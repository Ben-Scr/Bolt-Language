    byte* br_array_index(byte* ctx,byte* site,byte* type,byte* slot,long* indices,ulong rank) {
        byte* h=Ptr(slot,0ul);if(h==null || rank!=Word(type,40ul)){Bounds(ctx,site);return null;}
