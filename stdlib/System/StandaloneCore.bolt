#ifdef BoltStandaloneCore
namespace Bolt.Runtime;

// Private bootstrap ABI, compiled into the application. A string slot owns a
// header [data, byte length, reference count, cached hash] followed by immutable UTF-8.
// An array owns [data, count, capacity], dimensions, then its elements.
// Type descriptors hold kind, size, element, base, name and rank or field count.
static class StandaloneCore
{
public:
    byte* Allocate(ulong bytes) {
#ifdef Windows
        return (byte*)Bolt.Runtime.Windows.HeapAlloc(Bolt.Runtime.Windows.GetProcessHeap(),8u,bytes);
#else
        return Bolt.Runtime.StandalonePosix.AllocateZeroed(1ul,bytes);
#endif
    }
    void Free(byte* p) {
        if(p==null)return;
#ifdef Windows
        Bolt.Runtime.Windows.HeapFree(Bolt.Runtime.Windows.GetProcessHeap(),0u,p);
#elif Linux
        Bolt.Runtime.Linux.Free(p);
#else
        Bolt.Runtime.MacOS.Free(p);
#endif
    }
    // New allocations are registered by address. Validate delete without
    // reading freed or foreign storage. Workers share the root registry.
    // Nodes store the bucket link, descriptor and allocation-order links.
    // The root appends new objects so shutdown visits parents before allocations
    // made by their constructors. Child contexts never own this table.
    byte* HeapRoot(byte* ctx) { byte* root=Ptr(ctx,192ul);return root==null ? ctx : root; }
    ulong HeapBucket(byte* p) { return 240ul+8ul*((Word((byte*)&p,0ul)>>4)&255ul); }
    void HeapLock(byte* root) { while(AtomicOps.Cas(*((ulong*)&root[216ul]),0ul,1ul)!=0ul){} }
    void HeapUnlock(byte* root) { AtomicOps.Cas(*((ulong*)&root[216ul]),1ul,0ul); }
    byte* br_new(byte* ctx,byte* site,byte* type) {
        ulong size=Word(type,8ul);
        if(size>ulong.MaxValue-32ul){OutOfMemory(ctx,site);return null;}
        byte* node=Allocate(32ul+size);
        if(node==null){OutOfMemory(ctx,site);return null;}
        byte* value=&node[32ul],root=HeapRoot(ctx);ulong bucket=HeapBucket(value);
        Put(node,8ul,type);
        HeapLock(root);
        Put(node,0ul,Ptr(root,bucket));Put(root,bucket,node);
        byte* tail=Ptr(root,232ul);Put(node,16ul,tail);
        if(tail==null)Put(root,224ul,node);else Put(tail,24ul,node);
        Put(root,232ul,node);HeapUnlock(root);
        return value;
    }
    byte* UnlinkAllocation(byte* ctx,byte* value) {
        byte* root=HeapRoot(ctx),link=&root[HeapBucket(value)];
        HeapLock(root);
        byte* node=Ptr(link,0ul);
        while(node!=null && &node[32ul]!=value){link=node;node=Ptr(link,0ul);}
        if(node!=null){
            Put(link,0ul,Ptr(node,0ul));
            byte* previous=Ptr(node,16ul),next=Ptr(node,24ul);
            if(previous==null)Put(root,224ul,next);else Put(previous,24ul,next);
            if(next==null)Put(root,232ul,previous);else Put(next,16ul,previous);
        }
        HeapUnlock(root);return node;
    }
    void AbandonCopy(byte* ctx,byte* value) { Free(UnlinkAllocation(ctx,value)); }
    void br_new_failed(byte* ctx,byte* type,byte* value) {
        byte* node=UnlinkAllocation(ctx,value);
        DropIncomplete(type,value);Free(node);
    }
    void br_delete(byte* ctx,byte* site,byte* value) {
        if(value==null)return;
        byte* node=UnlinkAllocation(ctx,value);
        if(node==null){TypedMemory.InvalidDelete();return;}
        br_drop(Ptr(node,8ul),value);Free(node);
    }
    bool ReclaimAllocation(byte* ctx) {
        byte* first=Ptr(ctx,224ul);
        if(first==null){ReleaseStructBorrows(ctx);return false;}
        br_delete(ctx,null,&first[32ul]);return true;
    }
    void br_arena_failed(byte* ctx,byte* slot,byte* type,byte* value) {
        Region* state=(Region*)Ptr(slot,0ul);
        RegionRoot** link=&state->Roots;
        while(*link!=null && (*link)->Value!=value)link=&(*link)->Next;
        if(*link!=null){RegionRoot* root=*link;*link=root->Next;Free((byte*)root);}
        DropIncomplete(type,value);
    }
    // Active arenas are local to this execution. Locate the region containing
    // a destination field to allocate its owned string, box or buffer there.
    Region* RegionOf(byte* ctx,byte* slot) {
        if(ctx==null || slot==null)return null;
        Region* region=(Region*)Ptr(ctx,176ul);
        ulong address=Word((byte*)&slot,0ul);
        while(region!=null){
            RegionBlock* block=region->First;
            while(block!=null){
                ulong start=Word((byte*)&block,0ul)+(ulong)sizeof(RegionBlock);
                if(address>=start && address-start<block->Capacity)return region;
                block=block->Next;
            }
            region=region->Next;
        }
        return null;
    }
    byte* Storage(Region* region,ulong size) {
        if(region==null)return Allocate(size);
        return NativeArena.Reserve(region,size);
    }
    void FreeStorage(byte* storage) {
        if(storage!=null && RegionOf(ExecutionMemory.Context(),storage)==null)Free(storage);
    }
    void br_arena_create(byte* ctx,byte* site,byte* slot,ulong initial,ulong maximum,int grow) {
        Region* region=NativeArena.Create(initial,maximum,grow);
        if(region!=null){region->Next=(Region*)Ptr(ctx,176ul);Put(ctx,176ul,(byte*)region);}
        Put(slot,0ul,(byte*)region);
    }
    byte* br_arena_new(byte* ctx,byte* site,byte* slot,byte* type) {
        return NativeArena.Allocate((Region*)Ptr(slot,0ul),Word(type,8ul),type);
    }
    void br_arena_action(byte* ctx,byte* site,byte* slot,int dispose) {
        Region* state=(Region*)Ptr(slot,0ul);
        if(!NativeArena.Begin(state,dispose))return;
        while(state->Roots!=null){
            RegionRoot* root=state->Roots;state->Roots=root->Next;
            br_drop(root->Descriptor,root->Value);Free((byte*)root);
        }
        NativeArena.End(state,dispose);
        if(dispose!=0){
            Region** link=(Region**)&ctx[176ul];
            while(*link!=null && *link!=state)link=&(*link)->Next;
            if(*link!=null)*link=state->Next;
        }
    }
    ulong br_arena_stat(byte* ctx,byte* site,byte* slot,int property) {
        return NativeArena.Stat((Region*)Ptr(slot,0ul),property);
    }
    // Child executions share immutable descriptors and the root join registry.
    byte* br_context_registry(byte* ctx) {
        byte* root=Ptr(ctx,192ul);return root==null ? &ctx[200ul] : &root[200ul];
    }
    byte* br_context_child(byte* parent) {
        byte* child=Allocate(216ul);
        if(child!=null){
            // The reachable storage kernels use the same CPU features on every thread.
            *((uint*)&child[4ul])=*((uint*)&parent[4ul]);
            Bytes(&child[56ul],&parent[56ul],40ul);Put(child,168ul,Ptr(parent,168ul));
            byte* root=Ptr(parent,192ul);Put(child,192ul,root==null ? parent : root);
        }
        return child;
    }
    byte* br_context_activate(byte* ctx){return null;}
    ulong br_type_size(byte* type){return Word(type,8ul);}
    void br_destroy(byte* ctx){DisposeError(Ptr(ctx,40ul));Free(ctx);}
    byte* Ptr(byte* p, ulong at) { return *((byte**)&p[at]); }
    void Put(byte* p, ulong at, byte* v) { *((byte**)&p[at])=v; }
    ulong Word(byte* p, ulong at) { return *((ulong*)&p[at]); }
    void WordSet(byte* p, ulong at, ulong v) { *((ulong*)&p[at])=v; }
    void Bytes(byte* to, byte* from, ulong n) { for(ulong i=0ul;i<n;i++)to[i]=from[i]; }
    void Zero(byte* to, ulong n) { for(ulong i=0ul;i<n;i++)to[i]=0; }
    ulong CLength(byte* p) { ulong n=0ul; if(p!=null)while(p[n]!=0)n++;return n; }
    // Only read whole words inside the range. The decoder still validates
    // every non-ASCII scalar and stops at the first malformed sequence.
    ulong AsciiEnd(byte* data, ulong at, ulong limit) {
        while (limit - at >= 8ul && (Word(data, at) & 9259542123273814144ul) == 0ul)
            at += 8ul;
        while (at < limit && data[at] < 128) at++;
        return at;
    }
    ulong ScalarCount(byte* data, ulong length) {
        ulong at = 0ul, count = 0ul;
        while (at < length) {
            if (data[at] < 128) {
                ulong next = AsciiEnd(data, at, length);
                count += next - at;
                at = next;
            } else {
                if (ReadScalar(data, length, at) == uint.MaxValue) return ulong.MaxValue;
                count++;
            }
        }
        return count;
    }
    // Returns uint.MaxValue for malformed UTF-8. Advance the cursor only on success.
    uint ReadScalar(byte* data,ulong length,ulong& cursor) {
        ulong i=cursor;if(i>=length)return uint.MaxValue;
        uint first=(uint)data[i++];
        if(first<128u){cursor=i;return first;}
        if(first<194u || first>244u)return uint.MaxValue;
        uint tails=first<224u ? 1u : (first<240u ? 2u : 3u);
        if((ulong)tails>length-i)return uint.MaxValue;
        uint scalar=first & (tails==1u ? 31u : (tails==2u ? 15u : 7u));
        for(uint j=0u;j<tails;j++){
            uint next=(uint)data[i++];
            if((next&192u)!=128u)return uint.MaxValue;
            scalar=(scalar<<6)|(next&63u);
        }
        if((tails==2u && scalar<2048u) || (tails==3u && scalar<65536u) ||
           (scalar>=55296u && scalar<=57343u) || scalar>1114111u)return uint.MaxValue;
        cursor=i;return scalar;
    }
    ulong HashBytes(ulong hash,byte* data,ulong n) {
        for(ulong i=0ul;i<n;i++)hash=(hash^(ulong)data[i])*1099511628211ul;
        return hash;
    }
    ulong HashText(byte* slot) {
        byte* header=Ptr(slot,0ul);
        if(header==null)return 14695981039346656037ul;
        // Zero means uncomputed. MaxValue permanently disables caching once a
        // writable native pointer has escaped. Both remain valid hash results.
        ulong& cache=*((ulong*)&header[24ul]);
        ulong cached=AtomicOps.Add(cache,0ul);
        if(cached!=0ul && cached!=ulong.MaxValue)return cached;
        byte* data=Ptr(header,0ul);
        ulong hash=HashBytes(14695981039346656037ul,data,Word(header,8ul));
        if(cached==0ul && hash!=ulong.MaxValue)AtomicOps.Cas(cache,0ul,hash);
        return hash;
    }
    void WriteError(byte* data, ulong size) {
        if(size==0ul)return;
#ifdef Windows
        uint done=0u;
        Bolt.Runtime.Windows.WriteFile(Bolt.Runtime.Windows.GetStdHandle(4294967284u),data,(uint)size,&done,null);
#elif Linux
        Bolt.Runtime.Linux.Write(2,data,size);
#else
        Bolt.Runtime.MacOS.Write(2,data,size);
#endif
    }

    // Execution-state offsets 40 and 48 are the pending record and stack of catches.
    // The compact record contains the standard exception prefix at 16. Exceptions
    // with user fields own a full typed value at 48. Both expose the same prefix.
    void ReleaseText(byte* p) {
        if(p==null)return;
        ulong refs=AtomicOps.Add(*((ulong*)&p[16ul]),ulong.MaxValue);
        if((refs&9223372036854775807ul)==1ul)FreeStorage(p);
    }
    void AssignText(byte* ctx,byte* site,byte* dest,byte* header) {
        AssignRegionText(ctx,site,dest,header,RegionOf(ctx,dest));
    }
    void AssignRegionText(byte* ctx,byte* site,byte* dest,byte* header,Region* region) {
        if(header!=null && (region!=null || (AtomicOps.Add(*((ulong*)&header[16ul]),0ul)>>63)!=0ul)){
            MakeString(ctx,site,dest,Ptr(header,0ul),Word(header,8ul),region);return;
        }
        if(header!=null)AtomicOps.Add(*((ulong*)&header[16ul]),1ul);
        ReleaseText(Ptr(dest,0ul)); Put(dest,0ul,header);
    }
    byte* NewText(ulong size,Region* region) {
        if(size==0ul || size>ulong.MaxValue-33ul)return null;
        byte* p=Storage(region,33ul+size);
        if(p!=null) { Put(p,0ul,&p[32ul]); WordSet(p,24ul,0ul); WordSet(p,8ul,size); WordSet(p,16ul,region==null ? 1ul : 9223372036854775809ul); }
        return p;
    }
    void DisposeError(byte* e) {
        if(e==null)return;
        byte* payload=Ptr(e,48ul);
        if(payload!=null){br_drop(Ptr(e,8ul),payload);Free(payload);}
        else {ReleaseText(Ptr(e,24ul));ReleaseText(Ptr(e,40ul));}
        if(Word(e,56ul)==0ul)Free(e);else Zero(e,64ul);
    }
    byte* ErrorValue(byte* e) {
        byte* payload=Ptr(e,48ul);return payload==null ? &e[16ul] : payload;
    }
    void Error(byte* ctx,byte* site,byte* type,byte* message) {
        if(*((int*)ctx)!=0)return;
        byte* e=Allocate(64ul);
        if(e==null && Word(ctx,152ul)==0ul) {e=&ctx[96ul];WordSet(e,56ul,1ul);}
        if(e!=null) { Put(e,8ul,type);Put(e,16ul,type);AssignText(ctx,site,&e[24ul],message);Put(e,32ul,site);
            if(*((int*)ctx)!=0){DisposeError(e);return;} }
        Put(ctx,40ul,e);*((int*)ctx)=1;
    }
    void OutOfMemory(byte* ctx,byte* site) { Error(ctx,site,Ptr(ctx,56ul),null); }
    void Bounds(byte* ctx,byte* site) {
        byte* type=Ptr(ctx,64ul);CheckedFailure(ctx,site,type,Ptr(type,48ul));
    }
    void br_string(byte* ctx,byte* site,byte* dest,byte* data,ulong size) {
        MakeString(ctx,site,dest,data,size,RegionOf(ctx,dest));
    }
    void MakeString(byte* ctx,byte* site,byte* dest,byte* data,ulong size,Region* region) {
        if(size!=0ul && data==null){
            byte* type=Ptr(ctx,88ul);CheckedFailure(ctx,site,type,Ptr(type,48ul));return;
        }
        byte* h=NewText(size,region);
        if(size!=0ul && h==null) { OutOfMemory(ctx,site);return; }
        if(h!=null)Bytes(Ptr(h,0ul),data,size);
        Mutated(ctx,dest);ReleaseText(Ptr(dest,0ul));Put(dest,0ul,h);
    }
    byte* br_string_data(byte* slot,ulong* length) {
        byte* h=Ptr(slot,0ul);
        if(h==null){*length=0ul;return null;}
        *length=Word(h,8ul);return Ptr(h,0ul);
    }
    // NativeString.Bytes exposes a writable borrow. Detach existing snapshots
    // before handing out the pointer and copy future snapshots while it is live.
    byte* ExposeText(byte* ctx,byte* site,byte* slot,ulong* length) {
        byte* h=Ptr(slot,0ul);
        if(h==null){*length=0ul;return null;}
        ulong refs=AtomicOps.Add(*((ulong*)&h[16ul]),0ul);
        if(refs>1ul && (refs>>63)==0ul){
            byte* separate=NewText(Word(h,8ul),RegionOf(ctx,slot));
            if(separate==null){OutOfMemory(ctx,site);*length=0ul;return null;}
            Bytes(Ptr(separate,0ul),Ptr(h,0ul),Word(h,8ul));
            byte* reader=Ptr(ctx,160ul);
            while(reader!=null){
                if(Ptr(reader,24ul)==slot && Ptr(reader,32ul)==h)Put(reader,32ul,separate);
                reader=Ptr(reader,8ul);
            }
            Put(slot,0ul,separate);ReleaseText(h);h=separate;
        }
        ulong& cache=*((ulong*)&h[24ul]);
        ulong previous=AtomicOps.Add(cache,0ul);
        while(previous!=ulong.MaxValue){
            ulong actual=AtomicOps.Cas(cache,previous,ulong.MaxValue);
            if(actual==previous)break;
            previous=actual;
        }
        WordSet(h,16ul,9223372036854775809ul);*length=Word(h,8ul);return Ptr(h,0ul);
    }
    void br_concat(byte* ctx,byte* site,byte* dest,byte* a,byte* b) {
        ulong n=0ul,m=0ul;byte* x=br_string_data(a,&n),y=br_string_data(b,&m);
        if(n==0ul){Mutated(ctx,dest);AssignText(ctx,site,dest,Ptr(b,0ul));return;}
        if(m==0ul){Mutated(ctx,dest);AssignText(ctx,site,dest,Ptr(a,0ul));return;}
        if(m>18446744073709551615ul-n){OutOfMemory(ctx,site);return;}
        byte* h=NewText(n+m,RegionOf(ctx,dest));
        if(h==null){OutOfMemory(ctx,site);return;}
        byte* payload=Ptr(h,0ul);Bytes(payload,x,n);Bytes(&payload[n],y,m);
        Mutated(ctx,dest);ReleaseText(Ptr(dest,0ul));Put(dest,0ul,h);
    }
    int TextOrder(byte* a,byte* b) {
        ulong n=0ul,m=0ul;byte* x=br_string_data(a,&n),y=br_string_data(b,&m);
        for(ulong i=0ul;i<n && i<m;i++){if(x[i]!=y[i])return x[i]<y[i] ? -1 : 1;}
        return n<m ? -1 : (n>m ? 1 : 0);
    }
    int Compare(byte* ctx,byte* site,byte* type,byte* a,byte* b,int op) {
        int order=TextOrder(a,b);
        bool yes=op==0 ? order==0 : (op==1 ? order!=0 : (op==2 ? order<0 : (op==3 ? order<=0 : (op==4 ? order>0 : order>=0))));
        return yes ? 1 : 0;
    }
    ulong EncodeScalar(uint c,byte* bytes) {
        ulong n=c<128u ? 1ul : (c<2048u ? 2ul : (c<65536u ? 3ul : 4ul));
        if(bytes==null)return n;
        for(ulong i=n-1ul;i>0ul;i--){bytes[i]=(byte)(128u|(c&63u));c=c>>6;}
        bytes[0]=(byte)(c|(n==1ul ? 0u : (n==2ul ? 192u : (n==3ul ? 224u : 240u))));
        return n;
    }
    void Text(byte* ctx,byte* site,byte* dest,byte* type,byte* value) {
        if(Word(type,0ul)==5ul){AssignText(ctx,site,dest,Ptr(value,0ul));return;}
        uint storage=0u;byte* bytes=(byte*)&storage;
        ulong n=EncodeScalar(*((uint*)value),bytes);
        br_string(ctx,site,dest,bytes,n);
    }
    void PointerText(byte* ctx,byte* site,byte* dest,byte* value) {
        ulong pointer=Word(value,0ul),digits=1ul;
        for(ulong n=pointer;n>=16ul;n/=16ul)digits++;
        byte* h=NewText(digits+2ul,RegionOf(ctx,dest));
        if(h==null){OutOfMemory(ctx,site);return;}
        byte* data=Ptr(h,0ul);
        data[0]=48;data[1]=120;
        for(ulong i=digits+1ul;i>1ul;i--){
            ulong n=pointer&15ul;data[i]=(byte)(n<10ul ? 48ul+n : 87ul+n);pointer/=16ul;
        }
        ReleaseText(Ptr(dest,0ul));Put(dest,0ul,h);
    }
    void IntegerText(byte* ctx,byte* site,byte* dest,byte* type,byte* value) {
        ulong width=Word(type,8ul), magnitude=0ul;
        for(ulong i=0ul;i<width;i++)magnitude|=((ulong)value[i])<<(int)(8ul*i);
        bool negative=Word(type,0ul)==1ul && (value[width-1ul]&128)!=0;
        if(negative) {
            ulong mask=18446744073709551615ul;
            if(width<8ul)mask=(1ul<<(int)(8ul*width))-1ul;
            magnitude=(mask^magnitude)+1ul;
        }
        ulong count=(ulong)DecimalDigits.Count(magnitude);
        if(negative)count++;
        byte* h=NewText(count,RegionOf(ctx,dest));
        if(h==null){OutOfMemory(ctx,site);return;}
        byte* data=Ptr(h,0ul);
        ulong end=count;
        while(magnitude>=100ul){
            uint pair=(uint)(magnitude%100ul);
            magnitude/=100ul;
            data[--end]=(byte)(48u+pair%10u);
            data[--end]=(byte)(48u+pair/10u);
        }
        if(magnitude>=10ul){
            data[--end]=(byte)(48ul+magnitude%10ul);
            magnitude/=10ul;
        }
        data[--end]=(byte)(48ul+magnitude);
        if(negative)data[0]=45;
        ReleaseText(Ptr(dest,0ul));Put(dest,0ul,h);
    }
    int br_count(byte* ctx,byte* site,byte* type,byte* slot) {
        byte* h=Ptr(slot,0ul);if(h==null)return 0;
        ulong n=Word(h,8ul);
        if(Word(type,0ul)==5ul) {
            n=ScalarCount(Ptr(h,0ul),n);
            if(n==ulong.MaxValue){
                byte* ex=Ptr(ctx,168ul);CheckedFailure(ctx,site,ex,Ptr(ex,48ul));return 0;
            }
        }
        if(n>2147483647ul){Error(ctx,site,Ptr(ctx,72ul),null);return 0;}
        return (int)n;
    }
    bool HasExceptionBase(byte* type) {
        while(type!=null){if(Word(type,0ul)==15ul)return true;type=Ptr(type,24ul);}
        return false;
    }
    void CopyException(byte* ctx,byte* site,byte* type,byte* dest,byte* source) {
        Put(dest,0ul,type);AssignText(ctx,site,&dest[8ul],Ptr(source,8ul));
        Put(dest,16ul,Ptr(source,16ul));AssignText(ctx,site,&dest[24ul],Ptr(source,24ul));
    }
#if Windows || MacOS || FreeBSD || (Linux && (X64 || ARM64 || RISCV64))
    void CloseStream(Bolt.Runtime.IO.StreamState* state) {
        if(state==null || state->Closed)return;
        state->Closed=true;
        if(state->File){
#ifdef Windows
            Bolt.Runtime.StandaloneWindows.Close(state->Handle);
#else
            Bolt.Runtime.ProcessApi.Close(state->Descriptor);
#endif
        }
    }
    void ReleaseStream(Bolt.Runtime.IO.StreamState* state) {
        if(state==null)return;
        if(AtomicOps.Add(state->References,ulong.MaxValue)!=1ul)return;
        if(state->Parent!=null){
            if(state->OwnsParent)CloseStream(state->Parent);
            ReleaseStream(state->Parent);
        }
        CloseStream(state);
        Free(state->Data);
        Free((byte*)state);
    }
#endif
    // Capture cells share their mutable payload. Ordinary delegate boxes copy
    // the closure value, which in turn retains each captured cell.
    void ReleaseBox(byte* box) {
        if(box!=null && AtomicOps.Add(*(ulong*)box,ulong.MaxValue)==1ul){
            br_drop(Ptr(box,8ul),&box[16ul]);FreeStorage(box);
        }
    }
    void br_box(byte* ctx,byte* site,byte* target,byte* dest,byte* source,byte* value) {
        BoxInto(ctx,site,target,dest,source,value,RegionOf(ctx,dest));
    }
    // Headerless structs keep their native layout. An interface pointer or
    // reference to one uses a stable [descriptor, original address] view.
    // Intern the pair so copies and returned borrows keep the same identity.
    byte* BorrowStruct(byte* ctx,byte* site,byte* type,byte* value) {
        if(value==null)return null;
        byte* root=HeapRoot(ctx);
        HeapLock(root);
        byte* table=Ptr(root,2288ul);
        if(table==null){table=Allocate(2048ul);Put(root,2288ul,table);}
        byte* view=null;
        if(table!=null){
            ulong bucket=HeapBucket(value)-240ul;
            view=Ptr(table,bucket);
            while(view!=null && (Ptr(view,0ul)!=type || Ptr(view,8ul)!=value))view=Ptr(view,16ul);
            if(view==null){
                view=Allocate(24ul);
                if(view!=null){
                    Put(view,0ul,type);Put(view,8ul,value);Put(view,16ul,Ptr(table,bucket));Put(table,bucket,view);
                }
            }
        }
        HeapUnlock(root);
        if(view==null)OutOfMemory(ctx,site);
        return view;
    }
    void ReleaseStructBorrows(byte* root) {
        byte* table=Ptr(root,2288ul);
        if(table==null)return;
        for(ulong bucket=0ul;bucket<2048ul;bucket+=8ul){
            byte* view=Ptr(table,bucket);
            while(view!=null){byte* next=Ptr(view,16ul);Free(view);view=next;}
        }
        Free(table);Put(root,2288ul,null);
    }
    void BoxInto(byte* ctx,byte* site,byte* target,byte* dest,byte* source,byte* value,Region* region) {
