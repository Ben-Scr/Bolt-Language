    // Iterators borrow their source slot. A committed replacement invalidates all
    // readers of that slot even if the original string is assigned back to it.
    void Mutated(byte* ctx,byte* slot) {
        if(ctx==null || Word(ctx,32ul)==0ul)return;
        byte* r=Ptr(ctx,160ul);
        while(r!=null){if(Ptr(r,24ul)==slot)WordSet(r,40ul,1ul);r=Ptr(r,8ul);}
    }
    void EndRange(byte* r) {
        if(r==null)return;
        byte* ctx=Ptr(r,16ul),previous=Ptr(r,0ul),next=Ptr(r,8ul);
        if(previous==null)Put(ctx,160ul,next);else Put(previous,8ul,next);
        if(next!=null)Put(next,0ul,previous);
        WordSet(ctx,32ul,Word(ctx,32ul)-1ul);Free(r);
    }
    void br_range(byte* ctx,byte* site,byte* type,byte* source,byte* element,byte* output) {
        byte* r=Allocate(72ul);
        if(r==null){OutOfMemory(ctx,site);return;}
        EndRange(Ptr(output,0ul));
        byte* head=Ptr(ctx,160ul);
        Put(r,8ul,head);if(head!=null)Put(head,0ul,r);Put(ctx,160ul,r);
        Put(r,16ul,ctx);Put(r,24ul,source);Put(r,32ul,Ptr(source,0ul));Put(r,56ul,type);
        WordSet(ctx,32ul,Word(ctx,32ul)+1ul);Put(output,0ul,r);
    }
    byte* br_range_next(byte* ctx,byte* site,byte* slot) {
        byte* r=Ptr(slot,0ul),h=Ptr(r,32ul),type=Ptr(r,56ul);
        if(Word(r,40ul)!=0ul || h!=Ptr(Ptr(r,24ul),0ul)){
            byte* ex=Ptr(ctx,80ul);CheckedFailure(ctx,site,ex,Ptr(ex,48ul));return null;
        }
        ulong i=Word(r,48ul);
        if(h==null || i>=Word(h,8ul))return null;
        byte* data=Ptr(h,0ul);
        if(Word(type,0ul)!=5ul){
            WordSet(r,48ul,i+1ul);return &data[i*Word(Ptr(type,16ul),8ul)];
        }
        uint scalar=ReadScalar(data,Word(h,8ul),i);
        if(scalar==uint.MaxValue){
            byte* ex=Ptr(ctx,168ul);CheckedFailure(ctx,site,ex,Ptr(ex,48ul));return null;
        }
