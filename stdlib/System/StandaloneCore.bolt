        // Resolve hits and the final partial group in original index order.
        while(count-i>=8ul){
            T* group=&values[i];
            uint first=(group[0]==wanted ? 1u : 0u) | (group[1]==wanted ? 1u : 0u) |
                       (group[2]==wanted ? 1u : 0u) | (group[3]==wanted ? 1u : 0u);
            uint last=(group[4]==wanted ? 1u : 0u) | (group[5]==wanted ? 1u : 0u) |
                      (group[6]==wanted ? 1u : 0u) | (group[7]==wanted ? 1u : 0u);
            if((first | last)!=0u)break;
            i+=8ul;
        }
        for(;i<count;i++)if(values[i]==wanted)return (int)i;
