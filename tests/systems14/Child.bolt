import System
import System.Diagnostics
import System.Threading
static class Program {public:
 int Main(string[] args){
  if(args[0]=="echo"){
   Print(args[1]);Print(Environment.GetVariable("BOLT_SYSTEMS_TEST"));Trace.WriteLine("child-error");return 7;
  }
  if(args[0]=="flood"){
   string output="x".PadRight(180000,'x');Console.Write(output);Trace.WriteLine(output);return 0;
  }
  if(args[0]=="wait"){Thread.Sleep(10000);return 0;}
  if(args[0]=="input"){Print(Console.ReadLine());return 0;}
  if(args[0]=="cwd"){Print(Environment.CurrentDirectory);return 0;}
  return 9;
 }
}
