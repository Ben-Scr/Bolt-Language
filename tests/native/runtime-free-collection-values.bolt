import System
import System.Collections.Generic
import Bolt.Runtime

interface Tagged { int Tag(); }
class Label : IStringable, Tagged {
public:
    int Calls;
    int Tag() { return 1; }
    virtual string ToString() { return "label" + ++Calls; }
}
class Detail : Label {
public:
    int Number = 40;
    override string ToString() { return "detail" + (Number + ++Calls); }
}
struct Entry { public: Exception Fault; }

static class Program {
private:
    void Check(bool ok, string message) { if (!ok) throw Exception(message); }
    void Conversion<T>(string text, T expected) : Equatable<T> {
        T actual = default; int error = -1;
        Check(ScalarConversion.Float<T>(text, actual, error) && error == 0 && actual == expected, text);
    }
    bool SameError(Exception& a, Exception& b) { return Values.Equal<Exception>(a,b); }
    string Show(Label& value) { return Values.Format<Label>(value); }
    string ShowTag(Tagged& value) { return Values.Format<Tagged>(value); }
public:
    void Main() {
        Conversion("false", false); Conversion("😀", '😀'); Conversion(" a\0b ", " a\0b ");
        Conversion("255", (byte)255); Conversion("-2", (short)-2); Conversion("65", (ushort)65);
        Conversion("-42", -42); Conversion("100", 100u); Conversion("-78", -78l); Conversion("98", 98ul);
        Conversion("1.25", 1.25f); Conversion("-0.125", -0.125);
        int number = 37, error = 0;
        Check(!ScalarConversion.Float<int>("x",number,error) && number == 37 && error == 1,"format error");
        Check(!ScalarConversion.Float<int>("+-2147483649",number,error) && number == 37 && error == 2,"overflow");
        Check(ScalarConversion.Float<int>("42",number,number) && number == 0,"aliased outputs");

        Exception first("same"), copy("same"), other("other");
        ArgumentException argument("same");
        Check(SameError(first,copy) && !SameError(first,other) && !SameError(first,argument),"exception equality");
        Check(Values.Hash<Exception>(first) == Values.Hash<Exception>(copy),"exception hash");
        List<Exception> errors; errors.Add(first);
        Check(errors.Contains(copy) && !errors.Contains(other) && errors.ToString() == "[Exception: same]","exception list");
        HashSet<Exception> unique; unique.Add(first); unique.Add(copy); unique.Add(other);
        Check(unique.Count == 2 && unique.Contains(copy),"exception set");
        Dictionary<Exception,int> map; map.Add(first,42);
        Check(map[copy] == 42,"exception key");
        Entry a,b; a.Fault = first; b.Fault = copy;
        List<Entry> entries; entries.Add(a);
        Check(entries.Contains(b) && Values.Hash<Entry>(a) == Values.Hash<Entry>(b),"nested exception");
        Arena owner = Arena.Fixed(64ul), second = Arena.Fixed(64ul);
        ulong hash = Values.Hash<Arena>(owner);
        Check(Values.Equal<Arena>(owner,owner) && !Values.Equal<Arena>(owner,second)
              && Values.Hash<Arena>(owner) == hash,"arena identity");

        Detail child;
        Check(Show(child) == "detail41" && ShowTag(child) == "detail41" && child.Calls == 0,"borrowed snapshot");
        Label label;
        List<Label> labels; labels.Add(label);
        Queue<Label> queue; queue.Enqueue(label);
        HashSet<Label> set; set.Add(label);
        Dictionary<int,Label> names; names.Add(2,label);
        Check(labels.ToString() == "[label1]" && labels[0].Calls == 0,"list");
        Check(queue.ToString() == "[label1]" && set.ToString() == "{label1}" && names.ToString() == "{2: label1}","collections");
    }
}
