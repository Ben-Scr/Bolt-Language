static class Program {
public:
    void Main() {
        double x = 0.125;
        for (int i = 0; i < 5; i++) {
            double step = (double)(i & 3) * 0.125;
            x = x * 0.5 + step;
        }
        Print(Reinterpret<ulong>(x));
        try {
            double growing = 1.0;
            for (int i = 0; i < 2000; i++) {
                growing = growing * 2.0;
            }
            Print("missed overflow");
        } catch {
            Print("overflow");
        }
    }
}
