import Math
import Type

static class Program
{
public:
    bool Near(double actual, double expected, double tolerance)
    {
        return Math.Abs(actual - expected) <= tolerance;
    }
    int Main()
    {
        if (Math.Min(4l, 1) != 1l || Math.Max<byte>(3, 4) != (byte)4) return 1;
        if (Math.Sign<uint>(0u) != 0u || Math.Sign<uint>(42u) != 1u || Math.Sign<short>(-8) != (short)(-1)) return 2;
        if (Math.Abs<byte>((byte)255) != (byte)255 || Math.Abs<short>(-123) != (short)123 || Math.Abs(-2.0) != 2.0) return 3;
        double negativeZero = Reinterpret<double>(9223372036854775808ul);
        if (Reinterpret<ulong>(Math.Min(negativeZero, 0.0)) != 9223372036854775808ul) return 4;
        if (Reinterpret<ulong>(Math.Max(negativeZero, 0.0)) != 9223372036854775808ul) return 5;
        double nan = Reinterpret<double>(9221120237041090560ul);
        if (Reinterpret<ulong>(Math.Min(nan, 0.0)) != 9221120237041090560ul || Math.Sign(nan) != 0.0) return 6;
        if (Math.Clamp(5l, 0, 3) != 3l || Math.Clamp(0, 1, 3) != 1 || Math.Clamp(2, 1, 3) != 2) return 7;
        if (Math.Round(-2.5f) != -3.0f || Math.Round(2.5) != 3.0 || Math.Round(0.49999999999999994) != 0.0) return 8;
        if (Math.Truncate(-2.9) != -2.0 || Math.Floor(-0.1) != -1.0 || Math.Ceil(2.1) != Math.Ceiling(2.1)) return 9;
        if (Math.Round(ulong.MaxValue) != ulong.MaxValue || Reinterpret<ulong>(Math.Ceiling(-0.1)) != Reinterpret<ulong>(negativeZero)) return 10;
        if (Math.Sqrt(Reinterpret<double>(1ul)) != 2.2227587494850775e-162 || Reinterpret<ulong>(Math.Sqrt(negativeZero)) != Reinterpret<ulong>(negativeZero)) return 11;
        if (Math.Pow(-2.0, -3) != -0.125 || Math.Pow(2.0, -1074) != Reinterpret<double>(1ul) || !Near(Math.Pow(3.0, 1.5), 5.196152422706632, 2.0e-15)) return 12;
        if (!Near(Math.Exp(1.0), Math.E, 1.0e-15) || Math.Exp(-745.0) != Reinterpret<double>(1ul)) return 13;
        if (!Near(Math.Log(Math.E), 1.0, 3.0e-16) || Math.Log2(Reinterpret<double>(1ul)) != -1074.0 || !Near(Math.Log10(1000.0), 3.0, 1.0e-15)) return 14;
        if (!Near(Math.Sin(1.0e300), -0.8178819121159085, 3.0e-16) || !Near(Math.Cos(1.0e300), -0.5753861119575491, 3.0e-16)) return 15;
        if (!Near(Math.Tan(-0.5), -0.5463024898437905, 2.0e-16) || !Near(Math.Atan(2.0), 1.1071487177940905, 3.0e-16)) return 16;
        if (!Near(Math.Asin(-0.5), -0.5235987755982989, 2.0e-16) || !Near(Math.Acos(-0.5), 2.0943951023931957, 5.0e-16)) return 17;
        if (Math.Atan2(negativeZero, -1.0) != -Math.Pi || Math.Atan2(1.0, 0.0) != Math.Pi * 0.5) return 18;
        float infinity = Reinterpret<float>(2139095040u);
        if (Math.Atan2(infinity, infinity) != (float)(Math.Pi * 0.25) || Math.Pow(nan, 0.0) != 1.0) return 19;
        if (Math.Round(infinity) != infinity || Reinterpret<ulong>(Math.Floor(nan)) != Reinterpret<ulong>(nan)) return 20;
        if (Math.Sqrt(2.0) != 1.4142135623730951 || Math.Sqrt(double.MaxValue) != 1.3407807929942596e154) return 21;
        if (!Near(Math.Pow(double.MaxValue, 0.9999999999999999), 1.797693134862174e308, 4.0e292)) return 22;
        try { Math.Clamp(1, 2, 0); return 23; }
        catch (System.Exception e) { if (e.Message != "Math.Clamp min exceeds max") return 24; }
        try { Math.Sqrt(-1.0); return 25; } catch (System.OverflowException e) {}
        try { Math.Log(0.0); return 26; } catch (System.OverflowException e) {}
        try { Math.Pow(-2.0, 0.25); return 27; } catch (System.OverflowException e) {}
        try { Math.Exp(100.0f); return 28; } catch (System.OverflowException e) {}
        if (!Near(Math.Sin(Math.Pi / 4.0), 0.7071067811865475, 1.2e-16) ||
            !Near(Math.Cos(Math.Pi / 4.0), 0.7071067811865476, 1.2e-16)) return 29;
        if (Reinterpret<ulong>(Math.Sin(negativeZero)) != Reinterpret<ulong>(negativeZero) ||
            Math.Cos(negativeZero) != 1.0) return 30;
        return 0;
    }
}
