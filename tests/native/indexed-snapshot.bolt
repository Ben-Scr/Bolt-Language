import Bolt.Runtime
import System

static class Program {
public:
    int OverflowAtFill(int bias) {
        Buffer<int> source;
        for (int i = 0; i < 3; i++) source.Add(i + bias);
        int[] copy = source.ToArray();
        return copy[0];
    }

    ulong Sum(int limit, int start, int bias) {
        Buffer<int> buffer;
        for (int i = 0; i < limit; i++) buffer.Add(((i ^ 3) & 7) + (bias & 3));
        int[] values = buffer.ToArray();
        ulong total = 1ul;
        for (int i = start; i < values.Length; i++) total += (ulong)values[i];
        return total;
    }

    ulong MaskAfterCarry(int limit) {
        Buffer<int> buffer;
        for (int i = 0; i < limit; i++) buffer.Add((((i & 7) + 1) & 3));
        int[] values = buffer.ToArray();
        ulong total = 0ul;
        for (int i = 0; i < values.Length; i++) total += (ulong)values[i];
        return total;
    }

    int Main() {
        int limit = 13;
        Buffer<int> sequence;
        for (int i = 0; i < limit; i++) sequence.Add((i ^ 5) & 31);
        int[] values = sequence.ToArray();
        limit = 2;
        if (values.Length != 13 || values[12] != 9 || values[1] != 4) return 1;
        bool bounds = false;
        try { int value = values[-1]; } catch (Exception e) { bounds = true; }
        if (!bounds) return 2;

        int negative = -4;
        Buffer<int> empty;
        for (int i = 0; i < negative; i++) empty.Add(i);
        int[] none = empty.ToArray();
        if (none.Length != 0) return 3;

        Buffer<int> mutableBuffer;
        for (int i = 0; i < limit; i++) mutableBuffer.Add(i | 8);
        int[] writable = mutableBuffer.ToArray();
        int* alias = &writable[0];
        *alias = 55;
        if (writable[0] != 55 || writable[1] != 9) return 4;

        Buffer<int> observed;
        for (int i = 0; i < limit; i++) observed.Add(i);
        int[] stored = observed.ToArray();
        observed[0] = 32;
        if (stored[0] != 0) return 5;
        int bias = 11;
        int& aliasBias = bias;
        Buffer<int> bounded;
        for (int i = 0; i < 10; i++) bounded.Add(((i ^ 3) & 7) + (bias & 15));
        int[] frozen = bounded.ToArray();
        aliasBias = 0;
        if (frozen[0] != 14 || frozen[7] != 15 || frozen[9] != 13) return 6;
        bool overflow = false;
        try { int ignored = OverflowAtFill(int.MaxValue); } catch (Exception e) { overflow = true; }
        if (!overflow) return 7;
        if (Sum(0, 0, 1) != 1ul || Sum(1, 0, 3) != 7ul ||
            Sum(8, 0, 2) != 45ul || Sum(8, 3, 2) != 33ul ||
            Sum(5, 0, 2) != 24ul || MaskAfterCarry(8) != 12ul) return 8;
        return 0;
    }
}
