        if(alias.Position!=9 || alias.Length!=9 || alias.ToArray()[7]!=0) return 2;
        m.SetLength(2); m.SetLength(9); if(m.ToArray()[8]!=0 || alias.Position!=2) return 3;
        m.SetLength(0); int status=Binary(m); if(status!=0)return status;
        byte[] input={2,3,4}; MemoryStream src=MemoryStream(input);
        MemoryStream dest; src.CopyTo(dest,2); dest.Seek(-2,SeekOrigin.End);
        byte[] out=new byte[4]; if(dest.Read(out,1,2)!=2 || out[1]!=3 || out[2]!=4 || dest.ReadByte()!=-1)return 4;
        dest.Seek(0); if(dest.ReadAllBytes().Length!=3)return 5;
        bool invalid=false; try { m.CopyTo(alias); } catch(ArgumentException& e){invalid=true;}
        if(!invalid)return 6; alias.Dispose(); if(m.CanRead || m.ToArray().Length==0)return 7;
        FileStream f=File.Create("data"); status=Binary(f); if(status!=0)return status;
        f.SetLength(6); f.Seek(2,SeekOrigin.Begin); f.WriteByte(91); f.Seek(2);
        if(f.Length!=6 || f.Position!=2 || f.ReadByte()!=91)return 31;
        FileStream g=f; g.Close();
        if(f.CanWrite || File.GetLength("data")!=6)return 8;
        f=File.OpenWrite("data"); f.Write(input,1,2); f.Flush(); f.Dispose();
        f=File.OpenRead("data"); if(f.ReadByte()!=3 || f.ReadByte()!=4 || f.CanWrite)return 9; f.Close();
        f=File.Open("data",FileMode.Truncate,FileAccess.Write); f.Close();
        StreamWriter writer=StreamWriter("data"); StreamWriter copy=writer;
        writer.Write<string>("one\r"); copy.WriteLine<string>("two"); writer.WriteLine(); writer.Flush();
        writer.Close(); copy.Dispose();
        StreamWriter append=StreamWriter("data",true); append.Write<string>("rest"); append.Dispose();
        StreamReader reader=StreamReader("data"); if(reader.EndOfStream || reader.ReadLine()!="one" || reader.ReadLine()!="two")return 10;
        if(reader.ReadToEnd()!="\nrest" || !reader.EndOfStream)return 11;
        reader.Dispose(); reader.Close();
        MemoryStream text; StreamWriter w=StreamWriter(text,true); w.WriteLine<int>(42); w.Close();
        text.Seek(0); StreamReader sr=StreamReader(text,true);
        if(sr.ReadLine()!="42")return 12; sr.Close(); if(!text.CanRead)return 13;
        FileStream app=File.Open("data",FileMode.Append,FileAccess.ReadWrite);
        app.SetLength(3); app.Seek(0); app.WriteByte(65);
        if(app.Position!=4 || app.Length!=4)return 14;
        app.Close();
        text.SetLength(0); w=StreamWriter(text,true);
        w.WriteLine<double>(0.00001); w.Write<float>(1.25f); w.Dispose();
        if(string.FromUtf8(text.ToArray())!="1e-05\n1.25")return 15;
        byte[] invalidBytes={2}; MemoryStream bad=MemoryStream(invalidBytes); BinaryReader br=BinaryReader(bad);
        invalid=false; try{br.ReadBool();}catch(FormatException& e){invalid=true;}
