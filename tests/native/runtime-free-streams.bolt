import System
import System.IO

class Label : IStringable {
public:
    int N=7;
    string ToString(){N++;return "label"+N;}
}
sealed class DetailedLabel : Label {
public:
    int Extra=3;
    override string ToString(){Extra++;return "detail"+Extra;}
}
enum Code : ushort { Valid=513 }
static class Program {
    static void WriteLabel(StreamWriter& writer,Label& label){writer.Write<Label>(label);}
    static int Binary(Stream& stream) {
        BinaryWriter w = BinaryWriter(stream,true);
        w.Write<short>(-12); w.Write<int>(-123456); w.Write<long>(-5555555555l);
        w.Write<byte>((byte)222); w.Write<ushort>((ushort)65534); w.Write<uint>(3456789000u);
        w.Write<ulong>(9223372036854775900ul); w.Write<bool>(true); w.Write<char>('Ω');
        w.Write<float>(1.5f); w.Write<double>(-2.25); w.Write<string>("ä\0z");
        byte[] tail={3,4}; w.Write<byte[]>(tail); w.Flush(); w.Dispose(); w.Close();
        stream.Seek(0);
        BinaryReader r = BinaryReader(stream,true);
        if(r.ReadInt16()!=-12 || r.ReadInt()!=-123456 || r.ReadInt64()!=-5555555555l) return 20;
        if(r.ReadUInt8()!=222 || r.ReadUInt16()!=65534 || r.ReadUInt32()!=3456789000u) return 21;
        if(r.ReadUInt64()!=9223372036854775900ul || !r.ReadBool() || r.ReadChar()!='Ω') return 22;
        if(r.ReadFloat()!=1.5f || r.ReadDouble()!=-2.25 || r.ReadString()!="ä\0z") return 23;
        if(r.Read<byte>()!=3 || r.ReadBytes(1)[0]!=4) return 24;
        bool eof=false; try { r.ReadInt(); } catch(EndOfStreamException& e){ eof=true; }
        r.Close(); r.Dispose();
        return eof?0:25;
    }
public:
    static int Main() {
        MemoryStream m=MemoryStream(4); MemoryStream alias=m;
        if(!m.CanRead || !m.CanSeek || !m.CanWrite || m.Length!=0) return 1;
