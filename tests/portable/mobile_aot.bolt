#if Android || IOS
public struct PointerRecord { public: byte Tag; int* Address; double Offset; }
public struct DoubleRecord { public: byte Tag; double Number; }
public static class Program {
public:
    static int Calls = 0;
    int Main(string[] args) {
#if X86 || ARM32
        if(sizeof(int*) != 4 || sizeof(PointerRecord) != 16) return 6;
#else
        if(sizeof(int*) != 8 || sizeof(PointerRecord) != 24) return 6;
#endif
#if X86
        if(sizeof(DoubleRecord) != 12) return 7;
#else
        if(sizeof(DoubleRecord) != 16) return 7;
#endif
        if (args.Length != 1 || args[0] != "Funke 🌍") return 5;
        int[] parts = {10, 12, 19};
        int sum = 0;
        for (int part : parts) sum += part;
        Calls += 1;
        return sum + Calls;
    }
}
#else
#error This fixture requires a mobile target.
#endif
