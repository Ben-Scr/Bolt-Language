
public interface ICounter { int Add(int amount); int Get(); }
public class Counter : ICounter, IStringable {
public:
 int Value;
 Counter(int value) { Value=value; }
 int Add(int amount) { Value+=amount; return Value; }
 int Get() { return Value; }
 string ToString() { return $"Counter({Value})"; }
 static Counter operator +(Counter a,Counter b) { return Counter(a.Value+b.Value); }
 static Counter operator ++(Counter a) { return Counter(a.Value+1); }
 static Counter operator --(Counter a) { return Counter(a.Value-1); }
}
concept Textual<T> = IStringable<T>;
void Show<T>(T value):Textual {Print((string)value);}
static class Program {public: void Main(){
Show(6);Show(Counter(3));
}}
