public interface IName { string Name { get; } }
public class Base<T> {
public:
    T Item { get; set; }
}
public class Box<T> : Base<T> {
private:
    int stored = 0;
public:
    int Id { get; } = 4;
    int PrivateSet { get; private set; } = 3;
    static int Total { get; set; }
    int Twice => stored * 2;
    int WriteOnly { set { stored = value; } }
    Box(int id = 1) { Id = id; }
    void Change(int value) { PrivateSet = value; }
}
public class Named : IName {
public:
    string Name { get; set; } = "Bolt";
}
public static class Program {
public:
    void Main() {
        Box<string> b = Box<string>(8);
        b.Item = "Hello";
        b.WriteOnly = 6;
        b.Change(9);
        Box<string>.Total = 4;
        Box<string>.Total += 2;
        Print(b.Id); Print(b.Item); Print(b.Twice); Print(b.PrivateSet); Print(Box<string>.Total);
        Named item; IName& readable = item; Print(readable.Name);
    }
}
