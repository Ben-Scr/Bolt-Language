import System

[Header("posix-console-signal.h"), Native("bolt_console_watch_signal")]
extern "C" int WatchSignal();
[Header("posix-console-signal.h"), Native("bolt_console_take_signal")]
extern "C" int TakeSignal();

public static class Program {
public:
    int Main() {
        if (WatchSignal() != 0) return 1;
        Console.WriteLine("READ");
        if (Console.ReadLine() != "scene" || TakeSignal() == 0) return 2;
        string block = "Bolt";
        for (int i = 0; i < 18; i++) block = block + block;
        Console.WriteLine("WRITE");
        Console.Write(block);
        return TakeSignal() == 0 ? 3 : 0;
    }
}
