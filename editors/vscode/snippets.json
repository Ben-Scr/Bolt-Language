{
  "Program with Main": {
    "prefix": "main",
    "body": [
      "static class Program",
      "{",
      "public:",
      "    void Main()",
      "    {",
      "        ${0}",
      "    }",
      "}"
    ]
  },
  "Public class": {
    "prefix": "class",
    "body": [
      "public class ${1:Name}",
      "{",
      "public:",
      "    ${0}",
      "}"
    ]
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:count}; ${1:i}++)",
      "{",
      "    ${0}",
      "}"
    ]
  }
}
