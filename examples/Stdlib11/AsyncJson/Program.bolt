import System
import System.IO
import System.Threading.Tasks
import System.Text.Json

[Reflect]
public class Measurement
{
public:
    string Name { get; set; } = "Bolt";
    int Result { get; set; }
}

public static class Program
{
public:
    async Task<int> Main(string[] args)
    {
        await Task<void>.Delay(5);
        Measurement data;
        data.Result = 42;
        string path = args.Length > 0 ? args[0] : "measurement-0.11.json";
        await File.WriteAllTextAsync(path, Json.Serialize<Measurement>(data));
        string text = await File.ReadAllTextAsync(path);
        Measurement copy = Json.Deserialize<Measurement>(text);
        Print($"{copy.Name}: {copy.Result}");
        byte[] binary = Json.SerializeBinary<Measurement>(copy);
        Print($"BJS1 bytes: {binary.Length}");
        return 0;
    }
}
