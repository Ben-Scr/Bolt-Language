import Console

public class Vec2 {
public:
    float X;
    float Y;
}

public class Example {
public:
    void DoSomething() {
        for (int i = 0; i < iterations; i++) {
            Vec2 vector;
            vector.X = 5;
            vector.Y = 10;
            Console.WriteLine(vector.X + ", " + vector.Y);
        }
    }

private:
    int iterations = 100;
}

static class Program {
public:
    void Main() {
        Example example;
        example.DoSomething();
    }
}
