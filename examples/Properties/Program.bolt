import System.Collections.Generic

public struct Vec2
{
public:
    float X, Y;
    Vec2(float x = 0, float y = 0) : X(x), Y(y) {}
    [ReadOnly] float LengthSquared => X * X + Y * Y;
}

public class Player
{
private:
    int health = 100;
public:
    string Name { get; set; } = "Bolt";
    int Score { get; private set; }
    int Health
    {
        get { return health; }
        set { health = value < 0 ? 0 : value > 100 ? 100 : value; }
    }
    void AddScore(int amount) { Score += amount; }
}

public static class Program
{
    public static void Main()
    {
        int first = 1, second = 2, sum = first + second;
        Vec2 position = Vec2(3, 4);
        Player player;
        player.Name = "Ben";
        player.Health = 150;
        player.AddScore(sum);
        List<int> values;
        values.Add(10); values.Add(20);
        Print($"{player.Name}: health={player.Health}, score={player.Score}");
        Print($"Position squared length: {position.LengthSquared}");
        Print($"List length: {values.Length}; first item: {values[0]}");
    }
}
