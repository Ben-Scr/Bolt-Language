                        ". Erlaubt: " + AllowedDigits(sourceBase) + ".";
                return false;
            }
            digits[i] = (byte)digit;
        }

        while (start < digits.Length && digits[start] == 0) start++;
        if (start == digits.Length)
        {
            result = "0";
            return true;
        }

        // Schriftliche Division: Die gesamte Zahl muss nie in int/long passen.
        // Bei diesen Basen ist jeder Zwischenschritt hoechstens 255.
        List<byte> reversed;
        while (start < digits.Length)
        {
            int remainder = 0;
            for (int i = start; i < digits.Length; i++)
            {
