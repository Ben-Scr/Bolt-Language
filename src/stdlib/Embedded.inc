private:
    string Decimal(ulong magnitude, bool negative)
    {
        int length = DecimalDigits.Count(magnitude) + (negative ? 1 : 0);

        byte[] digits = new byte[length];
        int first = negative ? 1 : 0;
        for (int i = length - 1; i >= first; i--) {
            digits[i] = (byte)(48ul + magnitude % 10ul);
            magnitude /= 10ul;
        }
        if (negative) digits[0] = 45;
        return string.FromUtf8(digits);
    }

public:
