    int DigitValue(byte digit)
    {
        if (digit >= 48 && digit <= 57) return digit - 48;
        if (digit >= 65 && digit <= 70) return digit - 65 + 10;
        if (digit >= 97 && digit <= 102) return digit - 97 + 10;
        return -1;
