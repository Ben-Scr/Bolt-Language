import System.IO

public static class Program {
public:
    void Main() {
        byte[] data = File.ReadAllBytes("input.bin");
        int width = 128;
        int cells = width * width;
        int queries = (data.Length - cells) / 4;
        byte[] lengths = new byte[queries * 2];
        int[] queue = new int[cells];
        int[] distance = new int[cells];
        int[] seen = new int[cells];
        int[] offset = new int[4];
        offset[0] = 1; offset[1] = -1; offset[2] = width; offset[3] = -width;
        for (int request = 0; request < queries; request++) {
            int pos = cells + request * 4;
            int start = data[pos] + width * data[pos + 1];
            int goal = data[pos + 2] + width * data[pos + 3];
            int stamp = request + 1;
            int head = 0;
            int tail = 1;
            queue[0] = start;
            seen[start] = stamp;
            distance[start] = 0;
            int steps = 65535;
            while (head < tail) {
                int tile = queue[head++];
                if (tile == goal) {
                    steps = distance[tile];
                    break;
                }
                for (int direction = 0; direction < 4; direction++) {
                    int adjacent = tile + offset[direction];
                    if (data[adjacent] != 0 && seen[adjacent] != stamp) {
                        seen[adjacent] = stamp;
                        distance[adjacent] = distance[tile] + 1;
                        queue[tail++] = adjacent;
                    }
                }
            }
            lengths[request * 2] = (byte)(steps & 255);
            lengths[request * 2 + 1] = (byte)(steps >> 8);
        }
        File.WriteAllBytes("result.bin", lengths);
    }
}
