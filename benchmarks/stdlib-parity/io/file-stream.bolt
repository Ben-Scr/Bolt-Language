import System.IO

static class Program {
public:
    int Main() {
        byte[] block = new byte[8192];
        for (int i = 0; i < block.Length; i++) block[i] = (byte)(i & 127);
        long sum = 0l;
        for (int round = 0; round < 32; round++) {
            FileStream out = File.Open("stream.bin", FileMode.Create, FileAccess.Write);
            for (int i = 0; i < 128; i++) {
                block[0] = (byte)((round + i) & 127);
                out.Write(block);
            }
            out.Close();
            FileStream input = File.OpenRead("stream.bin");
            for (int i = 0; i < 128; i++) {
                int used = 0;
                while (used < block.Length) {
                    int count = input.Read(block, used);
                    if (count == 0) return 1;
                    used += count;
                }
                sum += block[0] + (int)block[block.Length - 1];
            }
            input.Close();
        }
        Print(sum);
        return 0;
    }
}
