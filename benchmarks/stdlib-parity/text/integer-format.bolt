import Bolt.Runtime

static class Program {
public:
    void Main() {
        ulong state = 917ul, total = 0ul;
        for (int i = 0; i < 1500000; i++) {
            state = Bits.Add64(Bits.Multiply64(state, 6364136223846793005ul), 1442695040888963407ul);
            string value = (string)state;
            total += (ulong)value.ByteLength + (ulong)value[0];
        }
        Print(total);
    }
}
