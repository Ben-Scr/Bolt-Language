struct Record {
public:
    int F0;
    int F1;
}
static class Program {
public:
    void Main() {
        Record[] data = new Record[1024];
        for (int i = 0; i < 1024; i++) {
            data[i].F0 = i + 1;
            data[i].F1 = i + 2;
        }
        for (int pass = 0; pass < 2048; pass++) {
            for (int i = 0; i < 1024; i++) {
                int k = (i + pass) & 1023;
                data[i] = data[k];
                data[i].F0 = data[i].F0 ^ i;
            }
        }
        long sum = 0l;
        for (int i = 0; i < 1024; i++) sum += data[i].F0 + data[i].F1;
        Print(sum);
    }
}
