static class Program {
public:
    void Main() {
        string[] left = new string[128];
        string[] right = new string[128];
        for (int i = 0; i < 128; i++) {
            int n = (i * 17) & 127;
            byte[] a = new byte[n];
            byte[] b = new byte[n];
            for (int j = 0; j < n; j++) {
                a[j] = (byte)((j + i) & 63);
                b[j] = a[j];
            }
            if (n > 0 && (i & 3) == 0) b[n - 1] ^= (byte)1;
            if (n > 0 && (i & 3) == 1) b[0] ^= (byte)1;
            left[i] = string.FromUtf8(a);
            right[i] = string.FromUtf8(b);
        }
        uint hash = 1u;
        for (int i = 0; i < 4000000; i++) {
            int k = (int)((hash + (uint)(i & 127)) & 127u);
            bool equal = left[k] == right[k];
            hash = ((hash << 3) ^ (hash >> 18) ^ (equal ? 17u : 51u)) & 16777215u;
        }
        Print(hash);
    }
}
