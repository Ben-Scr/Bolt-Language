static class Program {
public:
    void Main() {
        string[] text = new string[8];
        text[0] = "-1513.125";
        text[1] = "0.125";
        text[2] = "3.4028234e30";
        text[3] = "-1.1754944e-30";
        text[4] = "2.2250738585072014";
        text[5] = "17.00000095367431640625";
        text[6] = "0.10000000149011612";
        text[7] = "-2345.6789012345678";
        ulong sum = 17ul;
        for (int i = 0; i < 1000000; i++) {
            string item = text[(i ^ (i >> 3)) & 7];
            ulong a = Reinterpret<ulong>(double.Parse(item));
            uint b = Reinterpret<uint>(float.Parse(item));
            sum = ((sum << 7) | (sum >> 57)) ^ a ^ ((ulong)b << 24) ^ (ulong)i;
        }
        Print(sum);
    }
}
