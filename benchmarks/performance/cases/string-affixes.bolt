static class Program {
public:
    void Main() {
        string[] names = ["ui/menu.bin", "ui/menu.txt", "map/1.bin", "data", "", ".bin", "ui/", "ui/a.bin"];
        int score = 0;
        for (int i = 0; i < 2000000; i++) {
            int k = (i ^ (i >> 4)) & 7;
            if (names[k].StartsWith("ui/")) score++;
            if (names[k].EndsWith(".bin")) score += 2;
        }
        Print(score);
    }
}
